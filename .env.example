# ────────────────────────────────────────────────────────────────────────
# Neon (Postgres)
# ────────────────────────────────────────────────────────────────────────
# Provisioner via Vercel Marketplace > Storage > Neon (région Frankfurt EU),
# ou directement sur https://neon.tech (créer projet eu-central-1).
# DATABASE_URL = string pooled (utilisée par l'app à l'exécution)
# DATABASE_URL_UNPOOLED = string directe (utilisée par drizzle-kit pour les migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ────────────────────────────────────────────────────────────────────────
# Resend (emails transactionnels)
# ────────────────────────────────────────────────────────────────────────
# Compte gratuit sur https://resend.com
# RESEND_FROM_EMAIL : laisser "onboarding@resend.dev" tant que le domaine
# parvana.fr n'est pas vérifié dans Resend. Une fois vérifié, basculer sur
# "contact@parvana.fr".
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ────────────────────────────────────────────────────────────────────────
# Admin
# ────────────────────────────────────────────────────────────────────────
# Adresse email à laquelle Maryam reçoit les notifications de nouvelles
# demandes de réservation.
ADMIN_EMAIL=maryam@parvana.fr

# ────────────────────────────────────────────────────────────────────────
# Auth admin (mot de passe partagé)
# ────────────────────────────────────────────────────────────────────────
# Mot de passe unique partagé par Maryam et l'équipe. Pour le renouveler,
# changer cette variable et redéployer.
ADMIN_PASSWORD=

# Secret HMAC pour signer les cookies de session admin (≥ 24 caractères).
# Générer avec : openssl rand -hex 32
# Si modifié, toutes les sessions actives sont invalidées immédiatement.
ADMIN_SESSION_SECRET=

# ────────────────────────────────────────────────────────────────────────
# Site
# ────────────────────────────────────────────────────────────────────────
# URL canonique du site, utilisée dans les emails pour le lien admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────
# Cron — purge RGPD
# ────────────────────────────────────────────────────────────────────────
# Secret protégeant la route /api/cron/cleanup, déclenchée chaque semaine par
# Vercel Cron pour supprimer les demandes (réservations + traiteur) au-delà de
# la durée de conservation (13 mois). Vercel ajoute automatiquement l'en-tête
# « Authorization: Bearer <CRON_SECRET> » aux requêtes de cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# ────────────────────────────────────────────────────────────────────────
# Bot WhatsApp — commandes à emporter (Meta Cloud API, direct)
# ────────────────────────────────────────────────────────────────────────
# Créer une app Meta + un numéro WhatsApp Business (developers.facebook.com),
# puis configurer le webhook sur https://<site>/api/whatsapp avec le
# WHATSAPP_VERIFY_TOKEN ci-dessous, et s'abonner au champ « messages ».
#
# WHATSAPP_PHONE_NUMBER_ID : id du numéro Meta (pas le numéro lui-même).
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN : token System User permanent (scopes
# whatsapp_business_messaging + whatsapp_business_management).
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN : chaîne aléatoire choisie ici ET dans la config du
# webhook Meta (handshake GET). Générer avec : openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET : secret de l'app Meta, vérifie la signature
# X-Hub-Signature-256 des webhooks entrants.
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION : version de l'API Graph (optionnel, défaut v21.0).
WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_BOT_PAUSED : "1" pour mettre le bot en pause (le webhook reste
# vérifié côté Meta, mais les messages ne sont plus traités). Vide = actif.
WHATSAPP_BOT_PAUSED=
